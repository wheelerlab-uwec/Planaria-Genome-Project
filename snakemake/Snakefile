rule racon_round:
    input:
        assembly = lambda wildcards: "results/polished/medaka/consensus.fasta" if wildcards.round == "1" 
                   else f"results/polished/racon/round{int(wildcards.round)-1}.fasta",
        reads = "results/filtered/filtered_reads.fastq.gz"
    output:
        polished = "results/polished/racon/round{round}.fasta",
        alignment = temp("results/polished/racon/aligned_round{round}.sam")
    threads: config["threads"]["racon"]
    resources:
        mem_mb = config["memory"]["racon"],
        # runtime = 720  # 12 hours per round
    log:
        "logs/racon_round/run{round}.log"
    shell:
        """
        # Align reads
        minimap2 -ax map-ont -t {threads} {input.assembly} {input.reads} > {output.alignment} 2> {log}
        
        # Polish with Racon
        /data/users/wheelenj/GitHub/Planaria-Genome-Project/racon/build/bin/racon -t {threads} {input.reads} {output.alignment} {input.assembly} > {output.polished} 2>> {log}
        """

rule racon_final:
    input:
        expand("results/polished/racon/round{round}.fasta", 
               round=range(1, config["racon"]["rounds"] + 1))
    output:
        final = "results/polished/racon/final_racon_polished.fasta"
    params:
        last_round = config["racon"]["rounds"]
    shell:
        """
        cp results/polished/racon/round{params.last_round}.fasta {output.final}
        """

