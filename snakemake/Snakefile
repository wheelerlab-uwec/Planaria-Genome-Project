rule minimap_self_alignment:
    input:
        assembly = "results/polished/racon/final_racon_polished.fasta"
    output:
        paf = temp("results/final/purge_dups/assembly_self.paf.gz")
    threads: config["threads"]["purge_dups"]
    resources:
        mem_mb = 32000,
        runtime = 480  # 8 hours
    log:
        "logs/purge_dups_minimap.log"
    shell:
        """
        mkdir -p results/final/purge_dups
        minimap2 -xasm5 -DP -t {threads} {input.assembly} {input.assembly} 2> {log} | \
        gzip -c - > {output.paf}
        """

rule pbcstat:
    input:
        paf = "results/final/purge_dups/assembly_self.paf.gz"
    output:
        pbcstat = "results/final/purge_dups/PB.base.cov",
        stat = "results/final/purge_dups/PB.stat"
    params:
        prefix = "results/final/purge_dups/PB"
    log:
        "logs/purge_dups_pbcstat.log"
    shell:
        """
        pbcstat {input.paf} 2> {log}
        mv PB.base.cov {output.pbcstat}
        mv PB.stat {output.stat}
        """

rule calcuts:
    input:
        stat = "results/final/purge_dups/PB.stat"
    output:
        cutoffs = "results/final/purge_dups/cutoffs"
    log:
        "logs/purge_dups_calcuts.log"
    shell:
        """
        calcuts {input.stat} > {output.cutoffs} 2> {log}
        """

rule split_assembly:
    input:
        assembly = "results/polished/racon/final_racon_polished.fasta"
    output:
        split = "results/final/purge_dups/assembly.split.fasta"
    log:
        "logs/purge_dups_split.log"
    shell:
        """
        split_fa {input.assembly} > {output.split} 2> {log}
        """

rule minimap_reads_to_split:
    input:
        assembly = "results/final/purge_dups/assembly.split.fasta",
        reads = "results/filtered/filtered_reads.fastq.gz"
    output:
        paf = temp("results/final/purge_dups/split.paf.gz")
    threads: config["threads"]["purge_dups"]
    resources:
        mem_mb = 64000,
        runtime = 720  # 12 hours
    log:
        "logs/purge_dups_minimap_reads.log"
    shell:
        """
        minimap2 -xmap-ont -t {threads} {input.assembly} {input.reads} 2> {log} | \
        gzip -c - > {output.paf}
        """

rule purge_dups:
    input:
        paf = "results/final/purge_dups/split.paf.gz",
        base_cov = "results/final/purge_dups/PB.base.cov",
        cutoffs = "results/final/purge_dups/cutoffs"
    output:
        bed = "results/final/purge_dups/dups.bed"
    log:
        "logs/purge_dups_purge.log"
    shell:
        """
        purge_dups -2 -T {input.cutoffs} -c {input.base_cov} {input.paf} > {output.bed} 2> {log}
        """

rule get_seqs:
    input:
        assembly = "results/polished/racon/final_racon_polished.fasta",
        bed = "results/final/purge_dups/dups.bed"
    output:
        purged = "results/final/purged_assembly.fasta",
        haplotigs = "results/final/haplotigs.fasta"
    log:
        "logs/purge_dups_getseqs.log"
    shell:
        """
        get_seqs -e {input.bed} {input.assembly} 2> {log}
        
        # Move outputs to final locations
        mv purged.fa {output.purged}
        mv hap.fa {output.haplotigs}
        
        echo "Purging complete!" >> {log}
        echo "Purged assembly: {output.purged}" >> {log}
        echo "Haplotigs: {output.haplotigs}" >> {log}
        """

