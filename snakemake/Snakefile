rule busco_plot:
    input:
        summaries = [
            "results/busco/initial/short_summary.txt",
            "results/busco/racon/short_summary.txt",
            "results/busco/medaka/short_summary.txt",
            "results/busco/final/short_summary.txt"
        ]
    output:
        plot = "results/busco/busco_figure.png"
    params:
        busco_dir = "results/busco"
    log:
        "logs/busco_plot/run.log"
    shell:
        """
        # Copy each stage's short_summary JSON into a fresh plot directory
        rm -rf {params.busco_dir}/plot_input
        mkdir -p {params.busco_dir}/plot_input
        for f in {input.summaries}; do
            cp $(dirname $f)/short_summary.*.json {params.busco_dir}/plot_input/ 2>> {log}
        done
        
        # Generate the plot using BUSCO's built-in plotting function
        busco --plot {params.busco_dir}/plot_input 2>> {log}
        
        # Move the generated plot to the expected output location
        mv {params.busco_dir}/plot_input/busco_figure.png {output.plot} 2>> {log}
        """

rule quast:
    input:
        assemblies = [
            "results/assembly/flye/assembly.fasta",
            "results/polished/racon/final_racon_polished.fasta",
            "results/polished/medaka/consensus.fasta",
            "results/final/purged_assembly.fasta"
        ]
    output:
        report = "results/reports/quast/report.html"
    params:
        outdir = "results/reports/quast/"
    log:
        "logs/quast/run.log"
    shell:
        """
        quast.py {input.assemblies} -o {params.outdir} -t {threads}
        """

rule assembly_stats:
    input:
        assembly = "{prefix}.fasta"
    output:
        stats = "{prefix}_stats.txt"
    threads: config["threads"]["seqkit"]
    log:
        "logs/assembly_stats/{prefix}.log"
    shell:
        """
        seqkit stats -a -j {threads} -T {input.assembly} > {output.stats} 2> {log}
        """

rule compare_assembly_stats:
    input:
        flye = "results/assembly/flye/assembly_stats.txt",
        racon = "results/polished/racon/final_racon_polished_stats.txt",
        medaka = "results/polished/medaka/consensus_stats.txt",
        final = "results/final/purged_assembly_stats.txt"
    output:
        combined = "results/reports/assembly_statistics_comparison.tsv"
    log:
        "logs/compare_assembly_stats/run.log"
    shell:
        """
        echo -e "Stage\tnum_seqs\tsum_len\tmin_len\tmax_len\tN50\tL50\tmean_len\tmedian_len" > {output.combined}
        
        # Add stage names to each stats file
        tail -n +2 {input.flye} | sed 's/^/Flye\t/' >> {output.combined}
        tail -n +2 {input.racon} | sed 's/^/Racon\t/' >> {output.combined}
        tail -n +2 {input.medaka} | sed 's/^/Medaka\t/' >> {output.combined}
        tail -n +2 {input.final} | sed 's/^/Purged\t/' >> {output.combined}
        
        echo "Assembly statistics comparison complete" > {log}
        """

rule multiqc_report:
    input:
        summaries = [
            "results/busco/initial/short_summary.txt",
            "results/busco/racon/short_summary.txt",
            "results/busco/medaka/short_summary.txt",
            "results/busco/final/short_summary.txt"
        ],
        qc_initial = "results/qc/initial_qc/NanoStats.txt",
        qc_filtered = "results/qc/filtered_qc/NanoStats.txt"
    output:
        report = "results/reports/multiqc_report.html"
    params:
        search_dir = "results",
        outdir = "results/reports"
    log:
        "logs/multiqc/run.log"
    shell:
        """
        multiqc {params.search_dir} \
                --outdir {params.outdir} \
                --force \
                --title "Girardia dorotocephala Genome Assembly Report" \
                --filename multiqc_report.html \
                --comment "Complete pipeline QC including NanoPlot and BUSCO results" 2> {log}
        """


rule report:
    input:
        "results/busco/final/short_summary.txt"
    output:
        "results/reports/snakemake_report.html"
    shell:
        """
        snakemake --report {output}
        """


