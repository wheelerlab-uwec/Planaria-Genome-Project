configfile: "config.yaml"

rule all:
    input:
        # QC reports
        "results/qc/initial_qc/NanoStats.txt",
        "results/qc/filtered_qc/NanoStats.txt",
        
        # Assembly outputs
        "results/assembly/flye/assembly.fasta",
        
        # Polished assemblies
        "results/polished/medaka/consensus.fasta",
        "results/polished/racon/final_racon_polished.fasta",
        
        # Final purged assembly
        "results/final/purged_assembly.fasta",
        
        # BUSCO results at each stage
        "results/busco/initial/short_summary.txt",
        "results/busco/medaka/short_summary.txt",
        "results/busco/racon/short_summary.txt",
        "results/busco/final/short_summary.txt",
        
        # Comparison plot
        "results/busco/busco_figure.png"

rule initial_qc:
    input:
        reads = config["input_reads"] # check config.yaml for change to input_reads -- need path to cluster
    output:
        stats = "results/qc/initial_qc/NanoStats.txt"
    params:
        outdir = "results/qc/initial_qc"
    threads: 8
    resources:
        mem_mb = 32000,
        # runtime = 240  # 4 hours
    log:
        "logs/initial_qc/run.log"
    shell:
        r"""
        NanoPlot --fastq {input.reads} \
                 --outdir {params.outdir} \
                 --threads {threads} \
                 --plots kde hex 2> {log}
        """

rule filtlong:
    input:
        reads = config["input_reads"] # will change as done in the initial_qc
    output:
        filtered = "results/filtered/filtered_reads.fastq.gz"
    params:
        min_length = config["filtlong"]["min_length"],
        keep_percent = config["filtlong"]["keep_percent"],
        # target_bases = config["filtlong"]["target_bases"],
        min_mean_q = config["filtlong"]["min_mean_q"]
    threads: 16
    resources:
        mem_mb = 64000,
        # runtime = 2880  # 48 hours
    log:
        "logs/filtlong/run.log"
    shell:
        """
        filtlong --min_length {params.min_length} \
                 --keep_percent {params.keep_percent} \
                 --min_mean_q {params.min_mean_q} \
                 {input.reads} 2> {log} | gzip > {output.filtered}
        """

rule filtered_qc:
    input:
        reads = "results/filtered/filtered_reads.fastq.gz"
    output:
        stats = "results/qc/filtered_qc/NanoStats.txt"
    params:
        outdir = "results/qc/filtered_qc"
    threads: 8
    resources:
        mem_mb = 32000,
        # runtime = 240
    log:
        "logs/filtered_qc/run.log"
    shell:
        """
        NanoPlot --fastq {input.reads} \
                 --outdir {params.outdir} \
                 --threads {threads} \
                 --plots kde 2> {log}
        """

rule flye_assembly:
    input:
        reads = "results/filtered/filtered_reads.fastq.gz"
    output:
        assembly = "results/assembly/flye/assembly.fasta",
        info = "results/assembly/flye/assembly_info.txt"
    params:
        outdir = "results/assembly/flye",
        genome_size = config["genome_size"],
        iterations = config["flye"]["iterations"]
    threads: config["threads"]["flye"]
    resources:
        mem_mb = config["memory"]["flye"],
        # runtime = 4320  # 72 hours
    log:
        "logs/flye_assembly/run.log"
    shell:
        """
        flye --nano-raw {input.reads} \
             --out-dir {params.outdir} \
             --threads {threads} \
             --genome-size {params.genome_size} \
             --iterations {params.iterations} \
             --scaffold 2> {log}
        """

rule busco_initial:
    input:
        assembly = "results/assembly/flye/assembly.fasta"
    output:
        summary = "results/busco/initial/short_summary.txt"
    params:
        lineage = config["busco"]["lineage"],
        outdir = "results/busco/initial",
        mode = "genome"
    threads: config["threads"]["busco"]
    resources:
        mem_mb = 64000,
        # runtime = 720  # 12 hours
    log:
        "logs/busco_initial/run.log"
    shell:
        """
        busco -i {input.assembly} \
              -l {params.lineage} \
              -o $(basename {params.outdir}) \
              -m {params.mode} \
              -f \
              --cpu {threads} \
              --out_path $(dirname {params.outdir}) 2> {log}
        
        # Find and copy the summary file
        find {params.outdir} -name "short_summary*.txt" -exec cp {{}} {output.summary} \;
        """

rule medaka_polish:
    input:
        assembly = "results/assembly/flye/assembly.fasta",
        reads = "results/filtered/filtered_reads.fastq.gz"
    output:
        polished = "results/polished/medaka/consensus.fasta"
    params:
        outdir = "results/polished/medaka",
        # model = config["medaka"]["model"]
    threads: config["threads"]["medaka"]
    resources:
        mem_mb = config["memory"]["medaka"],
        # runtime = 2880  # 48 hours
    log:
        "logs/medaka_polish/run.log"
    shell:
        """
        medaka_consensus -i {input.reads} \
                         -d {input.assembly} \
                         -o {params.outdir} \
                         -t {threads} 2> {log}
        """

rule busco_medaka:
    input:
