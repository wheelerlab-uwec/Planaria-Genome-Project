configfile: "config.yaml"

rule all:
    input:
        # QC reports
        "results/qc/initial_qc/NanoStats.txt",
        "results/qc/filtered_qc/NanoStats.txt",
        
        # Assembly outputs
        "results/assembly/flye/assembly.fasta",
        
        # Polished assemblies
        "results/polished/racon/final_racon_polished.fasta",
        "results/polished/medaka/consensus.fasta",
        
        # Final purged assembly
        "results/final/purged_assembly.fasta",
        "results/final/haplotigs.fasta",
        
        # BUSCO results at each stage
        "results/busco/initial/short_summary.txt",
        "results/busco/racon/short_summary.txt",
        "results/busco/medaka/short_summary.txt",
        "results/busco/final/short_summary.txt",
        "results/busco/busco_figure.png",
        
        # Final QC/reports
        "results/reports/multiqc_report.html",
        "results/reports/snakemake_report.html",
        "results/reports/quast_report.html",
        "results/reports/assembly_statistics_comparison.tsv",

rule initial_qc:
    input:
        reads = config["input_reads"]
    output:
        stats = "results/qc/initial_qc/NanoStats.txt"
    params:
        outdir = "results/qc/initial_qc"
    log:
        "logs/initial_qc/run.log"
    shell:
        """
        NanoPlot --fastq {input.reads} \
                 --outdir {params.outdir} \
                 --threads {threads} \
                 --plots kde hex 2> {log}
        """

rule filtlong:
    input:
        reads = config["input_reads"]
    output:
        filtered = "results/filtered/filtered_reads.fastq.gz"
    params:
        min_length = config["filtlong"]["min_length"],
        keep_percent = config["filtlong"]["keep_percent"],
        min_mean_q = config["filtlong"]["min_mean_q"]
    log:
        "logs/filtlong/run.log"
    shell:
        """
        filtlong --min_length {params.min_length} \
                 --keep_percent {params.keep_percent} \
                 --min_mean_q {params.min_mean_q} \
                 {input.reads} 2> {log} | gzip > {output.filtered}
        """

rule filtered_qc:
    input:
        reads = "results/filtered/filtered_reads.fastq.gz"
    output:
        stats = "results/qc/filtered_qc/NanoStats.txt"
    params:
        outdir = "results/qc/filtered_qc"
    log:
        "logs/filtered_qc/run.log"
    shell:
        """
        NanoPlot --fastq {input.reads} \
                 --outdir {params.outdir} \
                 --threads {threads} \
                 --plots kde 2> {log}
        """

rule flye_assembly:
    input:
        reads = "results/filtered/filtered_reads.fastq.gz"
    output:
        assembly = "results/assembly/flye/assembly.fasta",
        info = "results/assembly/flye/assembly_info.txt"
    params:
        outdir = "results/assembly/flye",
        genome_size = config["genome_size"],
        iterations = config["flye"]["iterations"]
    threads: config["threads"]["flye"]
    resources:
        mem_mb = config["memory"]["flye"],
    log:
        "logs/flye_assembly/run.log"
    shell:
        """
        flye --nano-raw {input.reads} \
             --out-dir {params.outdir} \
             --threads {threads} \
             --genome-size {params.genome_size} \
             --iterations {params.iterations} \
             --scaffold 2> {log}
        """

rule busco_initial:
    input:
        assembly = "results/assembly/flye/assembly.fasta"
    output:
        summary = "results/busco/initial/short_summary.txt"
    params:
        lineage = config["busco"]["lineage"],
        outdir = "results/busco/initial",
        mode = "genome"
    threads: config["threads"]["busco"]
    log:
        "logs/busco_initial/run.log"
    shell:
        """
        busco -i {input.assembly} \
              -l {params.lineage} \
              -o $(basename {params.outdir}) \
              -m {params.mode} \
              -f \
              --cpu {threads} \
              --out_path $(dirname {params.outdir}) 2> {log}
        
        # Find and copy the summary file
        find {params.outdir} -name "short_summary*.txt" -exec cp {{}} {output.summary} \\;
        """

rule racon_round:
    input:
        assembly = lambda wildcards: "results/assembly/flye/assembly.fasta" if wildcards.round == "1" 
                   else f"results/polished/racon/round{int(wildcards.round)-1}.fasta",
        reads = "results/filtered/filtered_reads.fastq.gz"
    output:
        polished = "results/polished/racon/round{round}.fasta",
        alignment = "results/polished/racon/aligned_round{round}.sam"
    threads: config["threads"]["racon"]
    resources:
        mem_mb = config["memory"]["racon"],
    log:
        "logs/racon_round/run{round}.log"
    shell:
        """
        # Align reads
        minimap2 -ax map-ont -t {threads} {input.assembly} {input.reads} > {output.alignment} 2> {log}
        
        # Polish with Racon
        /data/users/wheelenj/GitHub/Planaria-Genome-Project/racon/build/bin/racon -t {threads} {input.reads} {output.alignment} {input.assembly} > {output.polished} 2>> {log}
        """

rule racon_final:
    input:
        expand("results/polished/racon/round{round}.fasta", 
               round=range(1, config["racon"]["rounds"] + 1))
    output:
        final = "results/polished/racon/final_racon_polished.fasta"
    params:
        last_round = config["racon"]["rounds"]
    shell:
        """
        cp results/polished/racon/round{params.last_round}.fasta {output.final}
        """

rule busco_racon:
    input:
        assembly = "results/polished/racon/final_racon_polished.fasta"
    output:
        summary = "results/busco/racon/short_summary.txt"
    params:
        lineage = config["busco"]["lineage"],
        outdir = "results/busco/racon",
        mode = "genome"
    threads: config["threads"]["busco"]
    log:
